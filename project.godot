; Engine configuration file.
; Tycoon Argentina — Godot 4.7

config_version=5

[application]

config/name="Tycoon Argentina"
config/description="Simulador de negocios pixel art: de un puestito callejero a un imperio empresarial."
config/version="0.2.0"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/pixel_art/logo/icono_192.png"
boot_splash/bg_color=Color(0.105882, 0.0941176, 0.172549, 1)
boot_splash/show_image=false
config/quit_on_go_back=false
run/max_fps=60

[autoload]

Settings="*res://scripts/settings/settings.gd"
Sfx="*res://scripts/audio/sfx.gd"
Monetization="*res://scripts/monetization/monetization.gd"
Game="*res://scripts/core/game.gd"

[display]

window/size/viewport_width=360
window/size/viewport_height=640
window/size/window_width_override=405
window/size/window_height_override=880
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"
window/handheld/orientation=1
window/energy_saving/keep_screen_on=false

[gui]

theme/default_font_antialiasing=0
theme/default_font_hinting=0
theme/default_font_subpixel_positioning=0
common/snap_controls_to_pixels=true

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[physics]

common/physics_ticks_per_second=30

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.105882, 0.0941176, 0.172549, 1)
